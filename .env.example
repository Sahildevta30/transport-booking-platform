# Copy this file to .env.local for local development.
# Never commit .env.local — it's already in .gitignore.

# --- Supabase (required) ---------------------------------------------------
# Project URL and anon key are safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key is PRIVILEGED and server-only. It bypasses Row Level
# Security. Never prefix this with NEXT_PUBLIC_, never import it into a
# client component, and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (Phase 2+, provider not yet chosen) --------------------------
# Populate once a provider (Razorpay/Cashfree/PhonePe/Stripe/etc.) is
# selected. Keep the app's payment code behind lib/payments/provider.ts
# so this section only ever needs one provider's variables at a time.
# PAYMENT_PROVIDER_API_KEY=
# PAYMENT_PROVIDER_WEBHOOK_SECRET=

# --- AI provider (Phase 2+, not yet chosen) ---------------------------------
# AI_PROVIDER_API_KEY=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
